rules_version = '2';

// ⚠️ Ces règles sont volontairement simples : n'importe qui connaissant l'URL de
// votre projet Firebase pourrait lire/écrire les données. Comme l'identifiant du
// projet n'est connu que de vous, c'est un niveau de sécurité correct pour un usage
// familial privé, mais PAS un vrai contrôle d'accès. Si vous voulez plus de sécurité
// plus tard, ajoutez l'authentification Firebase (voir le README).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
